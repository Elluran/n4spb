{
  "name": "piter-anime-walk",
  "version": "0.1.0",
  "description": "A walkable anime cel-shaded 3D scene of central Saint Petersburg (Moscow Railway Station, Vosstaniya Square, Nevsky Prospekt) with a metro built with plain three.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "dev:area": "node tools/area-dev.mjs",
    "check": "node tools/check.mjs environment streets city landmarksA landmarksB landmarksC props traffic people wildlife metro",
    "layout": "node tools/layout-test.mjs",
    "overlay": "node tools/overlay.mjs",
    "smoke": "node tools/smoke.mjs",
    "load": "node tools/load-test.mjs",
    "bake": "node tools/bake-scene.mjs",
    "bakedcheck": "node tools/baked-check.mjs",
    "muruzi": "node tools/muruzi-test.mjs",
    "partywalls": "node tools/party-wall-test.mjs",
    "belinsky": "node tools/belinsky-test.mjs",
    "wires": "node tools/wires-test.mjs",
    "paving": "node tools/street-paving-test.mjs",
    "roads": "node tools/roads.mjs",
    "ribbons": "node tools/streets-ribbon-audit.mjs",
    "markings": "node tools/streets-markings-audit.mjs --geom --strict",
    "plates": "node tools/streets-plates-sheet.mjs",
    "walls": "node tools/city-wall-audit.mjs",
    "labels": "node tools/city-label-audit.mjs",
    "facade": "node tools/city-facade-test.mjs",
    "banks": "node tools/environment-banks.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "three": "0.170.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0"
  }
}
